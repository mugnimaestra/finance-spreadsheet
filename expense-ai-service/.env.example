PORT=3000
API_TOKEN=your-secret-token-here

# Model configuration
# Default uses OpenRouter free auto-router which selects free vision-capable models
AI_MODEL=openrouter/openrouter/free

# OpenRouter API key - required by opencode CLI to use openrouter/* models
OPENROUTER_API_KEY=your-openrouter-api-key-here

FINANCE_SKILL_PATH=~/projects/finance-spreadsheet

# Webhook authentication secret - must match WEBHOOK_SECRET on telegram-bot-cloudflare Worker
WEBHOOK_SECRET=your-webhook-secret-here
